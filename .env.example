# =============================================================================
# DiamondTrading ERP - example environment file
# Copy to .env and fill in real values. NEVER commit .env.
# Placeholder values below are intentionally non-functional.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# API server (apps/api)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000

# Public base URL the browser uses to reach the API
API_PUBLIC_URL=http://localhost:4000

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=diamondtrading
POSTGRES_USER=diamondtrading
POSTGRES_PASSWORD=replace-me-local-only
DATABASE_URL=postgresql://diamondtrading:replace-me-local-only@localhost:5432/diamondtrading

# Connection pool
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# -----------------------------------------------------------------------------
# Auth / JWT
# Generate real secrets with: openssl rand -base64 48
# Each must be at least 32 characters.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=replace-with-a-long-random-value-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
COOKIE_SECRET=replace-with-a-long-random-cookie-secret-32-chars
COOKIE_SECURE=false
COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# -----------------------------------------------------------------------------
# Seed data (development only - used by `pnpm db:seed`)
# -----------------------------------------------------------------------------
SEED_TENANT_NAME=Demo Diamonds
SEED_TENANT_SLUG=demo
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMeLocally123!
SEED_ADMIN_NAME=Demo Administrator

# -----------------------------------------------------------------------------
# Web app (apps/web) - only VITE_* vars are exposed to the browser
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
VITE_APP_NAME=DiamondTrading
