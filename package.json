{
  "name": "diamondtrading",
  "version": "0.1.0",
  "private": true,
  "description": "Diamond Trading ERP - multi-tenant monorepo (web + api + shared)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"@diamond/*\" dev",
    "dev:api": "pnpm --filter @diamond/api dev",
    "dev:web": "pnpm --filter @diamond/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,css}\"",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @diamond/api db:generate",
    "db:migrate": "pnpm --filter @diamond/api db:migrate",
    "db:push": "pnpm --filter @diamond/api db:push",
    "db:studio": "pnpm --filter @diamond/api db:studio",
    "db:seed": "pnpm --filter @diamond/api db:seed",
    "clean": "pnpm -r exec rm -rf dist node_modules/.cache && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
